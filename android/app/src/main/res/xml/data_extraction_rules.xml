<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules. Mirror backup_rules.xml: never export
     the encrypted key prefs or the sandbox in cloud backup or device-to-device
     transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pifilling_secure_prefs.xml" />
        <exclude domain="file" path="linux-sandbox/" />
    <!-- Conversations can contain API keys pasted into a prompt and command
         output from the sandbox. They stay on this device. -->
    <exclude domain="file" path="chat-history.json" />
    <exclude domain="file" path="chat-history.json.bak" />
    <exclude domain="file" path="chat-history.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pifilling_secure_prefs.xml" />
        <exclude domain="file" path="linux-sandbox/" />
    <!-- Conversations can contain API keys pasted into a prompt and command
         output from the sandbox. They stay on this device. -->
    <exclude domain="file" path="chat-history.json" />
    <exclude domain="file" path="chat-history.json.bak" />
    <exclude domain="file" path="chat-history.json.tmp" />
    </device-transfer>
</data-extraction-rules>
